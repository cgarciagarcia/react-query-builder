{
  "name": "@cgarciagarcia/react-query-builder",
  "version": "1.22.1",
  "description": "React hook to build query strings compatible with spatie/laravel-query-builder",
  "main": "dist/bundle.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/bundle.js",
      "types": "./dist/index.d.ts"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm build:js && pnpm build:types",
    "build:js": "esbuild src/index.ts --bundle --minify --sourcemap --outfile=dist/bundle.js --format=esm --external:react",
    "build:types": "tsc && tsc-alias",
    "tag:generate": "standard-version",
    "release": "pnpm build && rm -rf ./dist/tests && npm publish --provenance --access public && rm -rf ./dist",
    "prepare": "husky",
    "pre-commit": "pnpm fix && pnpm test",
    "fix": "prettier --write \"./src/**/*.{js,cjs,mjs,ts,tsx,md,json}\" \"./tests/**/*\" --ignore-path .gitignore && pnpm lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgarciagarcia/react-query-builder.git"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "standard-version": "^9.5.0",
    "tsc-alias": "^1.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "react",
    "query-builder",
    "laravel-query-builder",
    "rest",
    "query",
    "api",
    "builder",
    "laravel"
  ],
  "author": "Carlos Garcia",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cgarciagarcia/react-query-builder/issues"
  },
  "homepage": "https://cgarciagarcia.github.io/react-query-builder/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "rolldown",
      "unrs-resolver"
    ]
  }
}
